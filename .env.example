# 本地開發：值來自 `supabase status` 的輸出
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status 顯示的 anon key>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<GCP 建立的 Maps 金鑰（限制 referrer 與 API）>

# 整合測試另需 .env.test.local（同樣不進版控）：
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# 交通段同步端點（/api/trips/[tripId]/legs/sync）另需（server-only，無 NEXT_PUBLIC_ 前綴、不進 client bundle）：
# GOOGLE_MAPS_SERVER_API_KEY=<GCP 建立的「無 referrer 限制、API 限制為 Routes API」伺服器金鑰；瀏覽器金鑰不能用於 server 呼叫>
# SUPABASE_SERVICE_ROLE_KEY=<supabase status 的 service_role key；用於 route_cache 讀寫，缺少時端點降級為跳過快取>
